# YaqinTop Environment Configuration
NODE_ENV=development
APP_NAME=YaqinTop
PORT=4000
API_PREFIX=/api/v1
PUBLIC_URL=http://localhost:4000

# Client App URLs for CORS
CUSTOMER_APP_URL=http://localhost:3000
MERCHANT_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# Database Configuration
# Leave DATABASE_URL empty to use the zero-dependency embedded development database engine
# Or set for PostgreSQL 16 + PostGIS: postgresql://yaqintop:secret@localhost:5432/yaqintop_db
DATABASE_URL=

# Session & Security
SESSION_SECRET=yaqintop_dev_session_secret_change_in_production_32chars
COOKIE_SECURE=false

# Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=yaqintop-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Routing Provider (osrm | valhalla | mock)
ROUTING_PROVIDER=mock
OSRM_CAR_ENDPOINT=http://router.project-osrm.org/route/v1/driving
OSRM_FOOT_ENDPOINT=http://router.project-osrm.org/route/v1/walking

# Stock Freshness Thresholds (Hours)
FRESH_HOURS_NEW=24
FRESH_HOURS_STALE=72
