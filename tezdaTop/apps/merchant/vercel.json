{
  "rewrites": [
    {
      "source": "/owner/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/owner/api/:path*",
      "destination": "https://tez-api.vercel.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tez-api.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
