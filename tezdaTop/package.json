{
  "name": "yaqintop-monorepo",
  "version": "1.0.0",
  "packageManager": "pnpm@12.9.1",
  "private": true,
  "description": "YaqinTop local product discovery and merchant operations platform for Uzbekistan",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @yaqintop/api dev",
    "dev:customer": "pnpm --filter @yaqintop/customer dev",
    "dev:merchant": "pnpm --filter @yaqintop/merchant dev",
    "dev:admin": "pnpm --filter @yaqintop/admin dev",
    "dev:moderator": "pnpm --filter @yaqintop/moderator dev",
    "dev:landing": "pnpm --filter @yaqintop/landing dev",
    "typecheck": "pnpm --filter \"@yaqintop/*\" --filter \"!@yaqintop/config\" exec tsc --noEmit",
    "build": "pnpm -r build",
    "preview:smoke": "node scripts/preview-smoke-check.cjs",
    "test": "pnpm --filter @yaqintop/api test",
    "test:all": "pnpm -r test",
    "lint": "pnpm -r lint",
    "import:pharmacies": "pnpm --filter @yaqintop/api import:pharmacies",
    "dev:dealer": "pnpm --filter @yaqintop/dealer dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
