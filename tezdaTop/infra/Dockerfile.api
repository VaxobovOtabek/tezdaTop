# ==========================================
# YaqinTop API - Multi-Stage Production Dockerfile
# Node 22 (Active LTS), pnpm 12.9.1
# ==========================================

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@12.9.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Deterministic frozen lockfile install without interactive prompts
RUN pnpm install --frozen-lockfile

# Build shared contracts and API
RUN pnpm --filter @yaqintop/contracts build
RUN pnpm --filter @yaqintop/api build

# Prune devDependencies to keep production image minimal
RUN pnpm prune --prod

# Stage 2: Runtime
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy production node_modules, package manifests and built distributions
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=node:node /app/packages ./packages
COPY --from=builder --chown=node:node /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=node:node /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=node:node /app/apps/api/src/data ./apps/api/src/data

# Run as non-root user for security
USER node

EXPOSE 4000

# Container healthcheck using built-in fetch in Node 22
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e 'fetch("http://127.0.0.1:4000/api/v1/health/live").then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

CMD ["node", "apps/api/dist/server.js"]
