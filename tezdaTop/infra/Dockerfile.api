FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@12.9.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc* ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

RUN pnpm approve-builds esbuild && pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @yaqintop/contracts build
RUN pnpm --filter @yaqintop/ui build
RUN pnpm --filter @yaqintop/api build

EXPOSE 4000
CMD ["node", "apps/api/dist/server.js"]
