# ==========================================
# YaqinTop Web (Nginx + Multi-SPA Frontends)
# Node 22 (Active LTS), pnpm 12.9.1
# ==========================================

# Stage 1: Build frontends
FROM node:22-alpine AS web-builder

WORKDIR /app

RUN npm install -g pnpm@12.9.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/ ./packages/
COPY apps/ ./apps/

# Deterministic frozen lockfile install
RUN pnpm install --frozen-lockfile

# Build shared packages
RUN pnpm --filter @yaqintop/contracts build
RUN pnpm --filter @yaqintop/ui build

# Build all client SPA apps
RUN pnpm --filter @yaqintop/landing build
RUN pnpm --filter @yaqintop/customer build
RUN pnpm --filter @yaqintop/merchant build
RUN pnpm --filter @yaqintop/admin build
RUN pnpm --filter @yaqintop/moderator build
RUN pnpm --filter @yaqintop/dealer build

# Stage 2: Nginx Web Server
FROM nginx:alpine

# Clean default html
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled SPA distributions
COPY --from=web-builder /app/apps/landing/dist /usr/share/nginx/html/landing
COPY --from=web-builder /app/apps/customer/dist /usr/share/nginx/html/customer
COPY --from=web-builder /app/apps/merchant/dist /usr/share/nginx/html/merchant
COPY --from=web-builder /app/apps/admin/dist /usr/share/nginx/html/admin
COPY --from=web-builder /app/apps/moderator/dist /usr/share/nginx/html/moderator
COPY --from=web-builder /app/apps/dealer/dist /usr/share/nginx/html/dealer

# Copy Nginx server configuration
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/api/v1/health/live || exit 1

CMD ["nginx", "-g", "daemon off;"]
