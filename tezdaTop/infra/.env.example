# =============================================================================
# YaqinTop Production Docker Environment Variables
# Copy to `infra/.env` or project root `.env` before running Docker Compose
# =============================================================================

# Node Environment
NODE_ENV=production
PORT=4000

# Supabase Credentials (Required for Production API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Backend Session Secret (Required: min 32 characters for HMAC signing)
SESSION_SECRET=your-production-session-secret-min-32-chars-placeholder

# Cookie security flag (true when served over HTTPS)
COOKIE_SECURE=true

# Public Base URL and Client Routing URLs
PUBLIC_URL=https://yaqintop.uz
LANDING_APP_URL=https://yaqintop.uz
CUSTOMER_APP_URL=https://yaqintop.uz/customer
MERCHANT_APP_URL=https://yaqintop.uz/owner
ADMIN_APP_URL=https://yaqintop.uz/admin
MODERATOR_APP_URL=https://yaqintop.uz/moderator
DEALER_APP_URL=https://yaqintop.uz/diller

# =============================================================================
# Optional Development Auxiliary Services (`docker compose --profile dev up`)
# =============================================================================
DEV_POSTGRES_DB=yaqintop_db
DEV_POSTGRES_USER=yaqintop
DEV_POSTGRES_PASSWORD=change_this_dev_password
DEV_MINIO_USER=minioadmin
DEV_MINIO_PASSWORD=change_this_minio_password
